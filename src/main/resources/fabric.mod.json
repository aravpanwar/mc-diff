{
	"schemaVersion": 1,
	"id": "mcdiff",
	"version": "${version}",
	"name": "mc-diff",
	"description": "See what you changed in your world: removed blocks in red, placed blocks in green, replaced blocks in yellow.",
	"authors": [
		"Arav Panwar"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.aravpanwar.mcdiff.McDiffClient"
		]
	},
	"mixins": [
		"mcdiff.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fantasy": ">=0.6.4"
	}
}
